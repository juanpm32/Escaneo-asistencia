# Almacen de las asistencias en el navegador.
# Vacio: el frontend llama al backend y ese backend elige la base con DB_TYPE.
# localstorage: personas y asistencias quedan en este navegador, sin base de datos.
# VITE_DB_MODE=localstorage
VITE_DB_MODE=

# Dejar vacio para usar el proxy de Vite (/api -> backend local).
# No apunte el celular a localhost del propio telefono.
# En Vercel, poner la URL publica del backend sin barra final:
# VITE_API_URL=https://control-asistencia-api.onrender.com
VITE_API_URL=
