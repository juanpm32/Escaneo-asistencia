PORT=3001

# El motor (mock, localstorage, sqlserver o postgres) esta en
# frontend/src/config/dataStore.json. Este archivo solo guarda la conexion.

# PostgreSQL, incluido el Postgres gratuito de Render.
# DATABASE_URL=postgres://usuario:clave@host:5432/control_asistencia
# DB_SSL=true

DB_HOST=localhost
DB_PORT=1433
DB_NAME=DB_CONTROL_ASISTENCIA
DB_USER=usuario
DB_PASSWORD=contraseña
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# En Render, el origen del frontend publicado en Vercel.
# CORS_ORIGIN=https://su-proyecto.vercel.app
