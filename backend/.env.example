# Una sola variable elige donde se guardan las asistencias.
#   mock          memoria del servidor. Se pierde al detenerlo.
#   localstorage  el navegador. No abre PostgreSQL ni SQL Server.
#   sqlserver     SQL Server (mssql tambien se acepta).
#   postgres      PostgreSQL.
DB_TYPE=mock
PORT=3001

# SQL Server. Descomente DB_TYPE y complete los datos de abajo.
# DB_TYPE=sqlserver

# PostgreSQL, incluido el Postgres gratuito de Render.
# DB_TYPE=postgres
# DATABASE_URL=postgres://usuario:clave@host:5432/control_asistencia
# DB_SSL=true

DB_HOST=localhost
DB_PORT=1433
DB_NAME=DB_CONTROL_ASISTENCIA
DB_USER=usuario
DB_PASSWORD=contraseña
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# En Render, el origen del frontend publicado en Vercel.
# CORS_ORIGIN=https://su-proyecto.vercel.app
