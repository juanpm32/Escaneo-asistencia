# Modo DEMO: no requiere base de datos. Los registros viven en memoria.
APP_MODE=demo
DB_TYPE=mock
PORT=3001

# SQL Server. Use estas dos variables juntas y los datos de abajo.
# APP_MODE=production
# DB_TYPE=mssql

# PostgreSQL, incluido el Postgres gratuito de Render.
# APP_MODE=production
# DB_TYPE=postgres
# DATABASE_URL=postgres://usuario:clave@host:5432/control_asistencia
# DB_SSL=true

DB_HOST=localhost
DB_PORT=1433
DB_NAME=DB_CONTROL_ASISTENCIA
DB_USER=usuario
DB_PASSWORD=contraseña
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
# En Render, el origen del frontend publicado en Vercel.
# CORS_ORIGIN=https://su-proyecto.vercel.app
